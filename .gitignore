# Mac
.DS_Store
._*
.Spotlight-V100
.Trashes
# Doublons Mac iCloud (suffix " 2.ext")
* 2.html
* 2.js
* 2.css
* 2.json
* 2.xml
* 2.png
* 2.jpg
* 2.svg

# Python (scripts)
__pycache__/
*.pyc
*.pyo

# Backups & temp
*.bak
*.tmp
*.original
*-bak.*
*-OLD.*

# Backup PNG (compression du 15/05/2026) — pas servi en prod
# cf. images/_backup_png/README.md ; pour purger l'historique :
#   git rm -r --cached images/_backup_png/
images/_backup_png/*
!images/_backup_png/README.md

# Logs
*.log

# Mascotte source (HD original — pas besoin sur le site)
images/mascotte1.png
images/mascotte-with-bg.png
# Variantes orphelines après passage au WebP (gardées sur disque mais non servies)
images/mascotte.png
images/mascotte-opt.png

# Vidéo originale énorme
videos/*.original
videos/*-OLD.*
videos/*-NOAUDIO-bak.*
# Vidéo source non compressée (remplacée par hero-metier-720p.mp4 servi en prod)
videos/hero-metier.mp4

# Supabase CLI cache (local, ne doit pas être committé)
supabase/.temp/
supabase/.branches/
.env
.env.local
# E2E local isolé (voie A) : env runtime avec service_role LOCAL éphémère — jamais commité
supabase/local-test/functions.env

# Autopush local config (contient SUPABASE_DB_PASSWORD)
.autopush/.env
.autopush/.db-password

# Secrets locaux (credentials Google/OAuth/etc — JAMAIS commité)
# Exception : on garde le README.md pour expliquer le dossier
secrets/*
!secrets/README.md
*.client_secret*.json
client_secret_*.json
*-credentials.json

# Token Netlify local (deploy staging/prod — JAMAIS commité)
tools/.netlify-access-token
*.netlify-access-token
*.html.bak
*.bak
# junk/temp (LOT L cleanup)
~$*
*.tmp.png
.agent1-lock
.helpconfort/agent1-lock
*.bak.before-minify

# Alerte locale de la surveillance (scripts/automation/monitoring-uptime.sh) : notifiée, pas versionnée
docs/ALERT-MONITORING.md

# Coupe-circuit local du démon d'auto-push : jamais versionné (sinon il resterait posé pour tout le monde)
.autopush-off

# Copies de conflit iCloud (« fichier 2.html ») : le dépôt est sous Documents/, synchronisé.
# Elles ont été committées par erreur le 2026-09-25 (162 fichiers) : plus jamais.
* 2.*
* 3.*
* 4.*
* 5.*

# Jeton de build Netlify : un POST sur cette URL declenche un deploiement de production.
# Il a ete committe par erreur le 2026-06-10 et retire le 2026-09-25 (depot PUBLIC).
.netlify-build-hook
tools/.netlify-build-hook
*.pem
*.key
*.p12
*.pfx
id_rsa*
.npmrc

# Rapports de scan internes : ecrits par scripts/maintenance-scan.py, figes depuis mai 2026,
# lus par personne, et servis publiquement jusqu au 2026-09-25. Gardes sur disque, hors du depot.
logs/

# Dossiers de conflit iCloud (« templates 2 ») : le motif fichier ne les attrapait pas.
* 2/
* 3/
* 4/
* 5/
