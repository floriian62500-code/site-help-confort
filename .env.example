# ════════════════════════════════════════════════════════════════════
# Configuration de la synchronisation Facebook → site
# ════════════════════════════════════════════════════════════════════
# Copie ce fichier en .env (sans le .example) et remplis les valeurs.
# Le fichier .env est ignoré par Git (voir .gitignore) — il reste local.
#
# Pour obtenir ton token : voir SETUP-API-FACEBOOK.md
# ════════════════════════════════════════════════════════════════════

# Token longue durée de la page Facebook (60 jours)
# À régénérer tous les 2 mois (voir étape 4 du guide)
FB_PAGE_ACCESS_TOKEN=EAA...colle_ici_ton_token_long_lived...

# ID de la page Facebook "Help Confort ST OMER"
FB_PAGE_ID=100064802658263
