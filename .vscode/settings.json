{
  "files.autoSave": "off",
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {},
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.enableSmartCommit": false,
  "git.allowForcePush": false,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/images/_backup_png/**": true,
    "**/logs/**": true
  }
}
